# Repo-root .env — copy to .env and replace the placeholder credentials.  Every value below is
# filled in with a working default, so a copy of this file runs the full sim demo as soon as the
# Anthropic key is real; with no credentials at all the bench still runs, it just can't talk.
#
# The agent reads software/agent/.env first and this file second (software/agent/src/config.ts).
# The Python side (backend, benchsim, tools) reads only the real environment, so export these
# before `uvicorn backend.app:app` or source the file: `set -a; . ./.env; set +a`.

# ---- Claude ------------------------------------------------------------------------------
# Used by the agent (software/agent/src/brain.ts) and benchsim's language layer
# (benchsim/ai/llm.py).  ANTHROPIC_AUTH_TOKEN works in place of the key for benchsim.
ANTHROPIC_API_KEY=sk-ant-api03-replace-me
ANTHROPIC_AUTH_TOKEN=
# only for org-level keys that aren't scoped to a workspace (the API says so in a 400);
# leave empty for a normal workspace key
ANTHROPIC_WORKSPACE_ID=
# the agent's model (default claude-opus-5)
AGENT_MODEL=claude-opus-5
# benchsim's model (default claude-opus-5-5; it falls back to opus-5 / fable-5-1 / sonnet-5-5)
BENCHSIM_LLM_MODEL=claude-opus-5-5

# ---- Photon Spectrum (iMessage provider) -------------------------------------------------
# From the project Settings page on app.photon.codes.  Leave BOTH empty to run terminal-only —
# no phone needed.  SPECTRUM_PROJECT_ID / SPECTRUM_PROJECT_SECRET in software/agent/.env win
# over these if both are set.
PHOTON_PROJECT_ID=
PHOTON_SECRET=

# ---- Agent ---------------------------------------------------------------------------------
# Where the agent finds the backend.
BACKEND_URL=http://127.0.0.1:8000
# comma list of imessage,terminal.  Empty = imessage+terminal when Photon creds are set,
# terminal alone otherwise.  Pin it to `terminal` to stay off iMessage even with creds.
AGENT_PROVIDERS=terminal
# what the agent calls itself in conversation
AGENT_NAME=Bench
# Humans who may approve runs and receive alerts, as E.164 phones (iMessage handles), comma
# separated.  Anyone else can ask questions and request runs, but a request waits for one of
# these to say yes.  Registered as operators in the backend's people registry on startup.
OPERATOR_PHONES=+15551234567
# texting "operator <code>" promotes the sender to operator (demo bootstrap); empty disables it
AGENT_BOOTSTRAP_CODE=bench-2026
# where the agent's spaces/*.json live; empty = software/agent/data/ (tests point at a temp dir)
DATA_DIR=

# ---- Backend (software/backend) ------------------------------------------------------------
# sim (default) or real for hardware.
WLB_BACKEND=sim
# 1 = render the camera (default), 0 = headless.
WLB_RENDER=1
# 1 = pace runs to wall-clock (the demo default), 0 = run flat out.
WLB_RT=1
# 1 = connect to the bench on startup (default), 0 = stay disconnected.
WLB_AUTOCONNECT=1
# how long an approval stays valid, in seconds.
WLB_APPROVAL_TTL_S=1800
# where runs and the people registry are stored; empty = software/out/backend.
WLB_BACKEND_DIR=

# ---- Tools ---------------------------------------------------------------------------------
# software/benchsim/benchsim/backends/real.py: compiler for the native helper.
# Empty = try c++, then clang++, then g++.
CXX=
# software/tools/planner: 1 plans the bench with the auger head and its gearmotor removed.
NO_AUGER=0
