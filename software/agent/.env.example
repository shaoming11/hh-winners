# Backend (software/backend/app.py)
BACKEND_URL=http://127.0.0.1:8000

# Claude
ANTHROPIC_API_KEY=sk-ant-...
# only if the key is an org-level key that is not scoped to a workspace (the API says so in a 400)
ANTHROPIC_WORKSPACE_ID=
AGENT_MODEL=claude-opus-5

# Photon Spectrum - from the project Settings page on app.photon.codes.  Leave both unset to
# run with the terminal provider only (local testing, no phone needed).  PHOTON_PROJECT_ID /
# PHOTON_SECRET in the repo-root .env are read too.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Which providers to start: comma list of imessage,terminal  (default: imessage if creds, +terminal)
AGENT_PROVIDERS=imessage,terminal

# Humans allowed to approve runs / receive alerts, as E.164 phones (iMessage handles).  They are
# registered as operators in the backend's people registry on startup.  Anyone else can ask
# questions and request runs, but a request waits until one of these says yes.
OPERATOR_PHONES=+15551234567
AGENT_NAME=Bench
# text "operator <code>" to the agent to become an operator (demo bootstrap); unset to disable
AGENT_BOOTSTRAP_CODE=
