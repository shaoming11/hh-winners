     "title": "Note",
     "type": "string"
    },
    "kind": {
     "const": "run_plan",
     "default": "run_plan",
     "title": "Kind",
     "type": "string"
    },
    "plan": {
     "anyOf": [
      {
       "$ref": "#/$defs/Plan"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "omit to run the preset with `recipe`"
    },
    "recipe": {
     "anyOf": [
      {
       "$ref": "#/$defs/Recipe"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "protocol_text": {
     "default": "",
     "description": "the plain-English protocol the plan came from",
     "title": "Protocol Text",
     "type": "string"
    },
    "operator": {
     "default": "",
     "title": "Operator",
     "type": "string"
    },
    "speed": {
     "default": 1.0,
     "exclusiveMinimum": 0,
     "maximum": 1.0,
     "title": "Speed",
     "type": "number"
    },
    "only": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "step-name prefixes to run, e.g. ['1','2']",
     "title": "Only"
    },
    "approved": {
     "default": false,
     "description": "true = skip the approval gate (operator at the bench)",
     "title": "Approved",
     "type": "boolean"
    },
    "requested_by": {
     "default": "",
     "description": "who asked for this run (chat handle / name); the approver goes in `operator`",
     "title": "Requested By",
     "type": "string"
    },
    "idempotency_key": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "e.g. the chat message id; a repeat returns the first reply instead of a second request",
     "title": "Idempotency Key"
    }
   },
   "required": [
    "id"
   ],
   "title": "RunPlanCmd",
   "type": "object"
  },
