  "RunPlanCmd": {
   "additionalProperties": false,
   "description": "Validate a plan, request operator approval (unless pre-approved), then run it.",
   "properties": {
    "v": {
     "default": "0.1.0",
     "description": "schema version of this command",
     "title": "V",
     "type": "string"
    },
    "id": {
     "description": "caller-chosen id; echoed in HardwareReply.id",
     "title": "Id",
     "type": "string"
    },
    "source": {
     "default": "frontend",
     "enum": [
      "frontend",
      "agent",
      "operator",
      "backend",
      "sequencer"
     ],
     "title": "Source",
     "type": "string"
    },
    "note": {
     "default": "",
