  "PlanStep": {
   "additionalProperties": false,
   "description": "One step of benchsim.process.steps.  `params` is checked by `steps.validate`, the only\ngate before execution - it is deliberately an open dict here so the two never drift.",
   "properties": {
    "type": {
     "enum": [
      "TRANSFER",
      "POUR_TO_SCALE",
      "POUR_TO_FUNNEL",
      "CAROUSEL",
      "DOSE_YEAST",
      "VERIFY_MASS",
      "WAIT",
      "STAGE"
     ],
     "title": "Type",
     "type": "string"
    },
    "params": {
     "additionalProperties": true,
     "description": "per-type params; see benchsim.process.steps",
     "title": "Params",
     "type": "object"
    },
    "label": {
     "default": "",
     "title": "Label",
     "type": "string"
    }
   },
   "required": [
    "type"
   ],
   "title": "PlanStep",
   "type": "object"
  },
  "PlaybackCmd": {
   "additionalProperties": false,
   "description": "Play a recorded hardware replay (runs/<run_id>/telemetry.jsonl) back into the sim world: the arms follow the\nrecorded joint angles, the carousel and sled the recorded axes, and the steps / subgoals / checks change status\nwhen they did in the recording.  Sim only: nothing on the bench moves.",
   "properties": {
    "v": {
     "default": "0.1.0",
     "description": "schema version of this command",
     "title": "V",
     "type": "string"
    },
    "id": {
     "description": "caller-chosen id; echoed in HardwareReply.id",
     "title": "Id",
     "type": "string"
    },
    "source": {
     "default": "frontend",
     "enum": [
      "frontend",
      "agent",
      "operator",
      "backend",
      "sequencer"
     ],
     "title": "Source",
     "type": "string"
    },
    "note": {
     "default": "",
     "description": "free text: why this command was issued (goes in the log)",
     "title": "Note",
     "type": "string"
    },
    "kind": {
     "const": "playback",
     "default": "playback",
     "title": "Kind",
     "type": "string"
    },
    "run_id": {
     "description": "a recording, e.g. 'hw-20261018_021902' (GET /api/recordings)",
     "title": "Run Id",
     "type": "string"
    },
    "speed": {
     "default": 1.0,
     "description": "playback speed (1 = as recorded)",
     "exclusiveMinimum": 0,
     "maximum": 8.0,
     "title": "Speed",
     "type": "number"
    },
    "requested_by": {
     "default": "",
     "title": "Requested By",
     "type": "string"
    }
   },
   "required": [
    "id",
    "run_id"
   ],
   "title": "PlaybackCmd",
   "type": "object"
  },
